# ============================================================
#  Backend Environment Variables Template
# ============================================================

# Server
NODE_ENV=development
PORT=5001

# Database (In Docker: DB_HOST=db, Local: DB_HOST=localhost)
DB_HOST=db
DB_PORT=3306
DB_NAME=efootball_db
DB_USER=efootball_user
DB_PASSWORD=efootball_pass
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=your-super-secret-key-minimum-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=another-secret-key-minimum-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d

# AI Vision Service
AI_VISION_PROVIDER=gemini
AI_VISION_API_KEY=your_gemini_api_key_here
AI_VISION_MODEL=gemini-2.0-flash
AI_VISION_TIMEOUT_MS=30000

# Security (Handover Room AES-256-GCM encryption key - 32 chars/bytes)
HANDOVER_ENCRYPTION_KEY=your_32_byte_secret_encryption_k

# CORS Whitelist
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_SCAN=10
UPLOAD_TEMP_DIR=./uploads
STORAGE_TYPE=local

# Platform Business Rules
PLATFORM_FEE_RATE=0.05
PAYMENT_DEADLINE_HOURS=2
HANDOVER_TIMEOUT_HOURS=72
BUYER_CONFIRM_DEADLINE_HOURS=24
AUTO_RELEASE_HOURS=48
DISPUTE_SLA_HOURS=48
